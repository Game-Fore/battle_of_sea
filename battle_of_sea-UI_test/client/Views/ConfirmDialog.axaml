<?xml version="1.0" encoding="utf-8"?>
<!-- Диалог подтвержди -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BattleOfSea.Views.ConfirmDialog"
        Width="380" Height="220" WindowStartupLocation="CenterOwner"
        Title="Подтверждение">
  <StackPanel Margin="20" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
    <TextBlock Text="{Binding Message}" FontSize="14" 
               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,20,0,0">
      <Button Name="YesButton" Content="{Binding YesButtonText}" Width="120" Click="Yes_Click" />
      <Button Name="NoButton" Content="{Binding NoButtonText}" Width="120" Click="No_Click" />
    </StackPanel>
  </StackPanel>
</Window>
