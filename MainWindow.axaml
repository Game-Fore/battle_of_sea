<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BattleOfSea.Views"
        x:Class="BattleOfSea.MainWindow"
        Title="Battle of Sea" Width="900" Height="600"
        Background="#e6f7ff" MinWidth="800" MinHeight="520">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#dbeafe" Padding="12">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
        <TextBlock Text="Battle of Sea" FontSize="18" FontWeight="Bold" Margin="6,0" />
        <TextBlock Text="— демо" Foreground="#065f46" VerticalAlignment="Center" Opacity="0.9" />
      </StackPanel>
    </Border>

    <ContentControl Name="MainContent">
      <views:LobbyView Name="LobbyViewControl" />
    </ContentControl>
  </DockPanel>
</Window>
