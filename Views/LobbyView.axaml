<?xml version="1.0" encoding="utf-8"?>
<!-- Экран лобби -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BattleOfSea.Views.LobbyView">
  <Grid ColumnDefinitions="3*,2*" RowDefinitions="Auto,*" Margin="10">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
      <TextBlock Text="Лобби" FontSize="20" Margin="4" />
    </StackPanel>

    <ListBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}" Name="RoomsList">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Padding="6" Margin="4" BorderBrush="#cbd5e1" BorderThickness="1" Background="#ffffff" CornerRadius="8">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
              <!-- simple ship icon -->
              <TextBlock Text="⛵" FontSize="22" VerticalAlignment="Center" Margin="8" />

              <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                <TextBlock Text="{Binding PlayersDisplay}" FontSize="12" Opacity="0.7" />
              </StackPanel>

              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <TextBlock Classes="badge" Text="{Binding PlayersDisplay}" VerticalAlignment="Center" />
                <Button Content="Присоединиться" Command="{Binding DataContext.JoinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" IsEnabled="{Binding IsJoinAllowed}" 
                        HorizontalContentAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <StackPanel Grid.Row="1" Grid.Column="1" Margin="8" VerticalAlignment="Top" Spacing="8">
      <Button Content="Создать комнату" Click="CreateRoom_Click" 
              Width="200" FontSize="14" HorizontalAlignment="Stretch" 
              HorizontalContentAlignment="Center" />
      <Button Content="Обновить список" Command="{Binding RefreshCommand}" 
              Width="200" FontSize="14" HorizontalAlignment="Stretch" 
              HorizontalContentAlignment="Center" />
    </StackPanel>
  </Grid>
</UserControl>
