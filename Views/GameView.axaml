<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BattleOfSea.Controls"
             xmlns:views="clr-namespace:BattleOfSea.Views"
             x:Class="BattleOfSea.Views.GameView">
  <StackPanel Margin="8" Spacing="8">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
      <Button Content="Выйти в лобби" Click="ExitToLobby_Click" />
      <TextBlock Text="{Binding StatusText}" FontSize="18" HorizontalAlignment="Center" Margin="12,0,0,0" />
      <TextBlock Text="{Binding RoomName, StringFormat='Комната: {0}'}" FontSize="12" Margin="12,4,0,0" />
    </StackPanel>

    <controls:TimerControl HorizontalAlignment="Center" />
    <views:BoardView />
  </StackPanel>
</UserControl>