<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BattleOfSea.Controls"
             xmlns:views="clr-namespace:BattleOfSea.Views"
             x:Class="BattleOfSea.Views.GameView">
  <StackPanel Margin="8" Spacing="8">
    <!-- Экран размещения кораблей -->
    <views:ShipPlacementView DataContext="{Binding}" IsVisible="{Binding ShowPlacement}" />

    <!-- Экран игры -->
    <StackPanel IsVisible="{Binding ShowGame}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="12">
        <Button Content="Выйти в лобби" Click="ExitToLobby_Click" />
        <Border Padding="12,6" CornerRadius="8" Background="{Binding StatusBackground}">
          <TextBlock Text="{Binding StatusText}" FontSize="18" FontWeight="Bold" 
                     Foreground="{Binding StatusForeground}" />
        </Border>
        <TextBlock Text="{Binding RoomName, StringFormat='Комната: {0}'}" FontSize="12" 
                   VerticalAlignment="Center" Opacity="0.7" />
      </StackPanel>

      <!-- День 12: UX улучшения - счетчики кораблей -->
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="24" Margin="0,8">
        <Border Padding="12,6" CornerRadius="8" Background="#E0E7FF">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Ваши корабли:" FontSize="14" FontWeight="Bold" />
            <TextBlock Text="{Binding OwnRemainingShips}" FontSize="14" FontWeight="Bold" Foreground="#4338CA" />
          </StackPanel>
        </Border>
        <Border Padding="12,6" CornerRadius="8" Background="#FEE2E2">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Корабли противника:" FontSize="14" FontWeight="Bold" />
            <TextBlock Text="{Binding EnemyRemainingShips}" FontSize="14" FontWeight="Bold" Foreground="#DC2626" />
          </StackPanel>
        </Border>
      </StackPanel>

      <controls:TimerControl HorizontalAlignment="Center" />
      <views:BoardView DataContext="{Binding}" />
    </StackPanel>
  </StackPanel>
</UserControl>