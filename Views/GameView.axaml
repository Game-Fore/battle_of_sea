<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BattleOfSea.Controls"
             xmlns:views="clr-namespace:BattleOfSea.Views"
             x:Class="BattleOfSea.Views.GameView">
  <StackPanel Margin="8" Spacing="8">
    <TextBlock Text="{Binding StatusText}" FontSize="18" HorizontalAlignment="Center" />
    <controls:TimerControl HorizontalAlignment="Center" />
    <views:BoardView />
  </StackPanel>
</UserControl>