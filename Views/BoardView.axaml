<?xml version="1.0" encoding="utf-8"?>
<!-- Отрисовка поля -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BattleOfSea.Views.BoardView">
  <StackPanel Orientation="Horizontal" Spacing="48" HorizontalAlignment="Center" Margin="16,0">
    <!-- Мое поле -->
    <StackPanel Margin="0,0,24,0">
      <TextBlock Text="Мое поле" FontWeight="Bold" FontSize="16" Margin="0,0,0,8" HorizontalAlignment="Center" />
      <Grid Name="OwnBoardGrid">
        <!-- Grid будет создан в code-behind -->
      </Grid>
    </StackPanel>

    <!-- Поле противника -->
    <StackPanel Margin="24,0,0,0">
      <TextBlock Text="Поле противника" FontWeight="Bold" FontSize="16" Margin="0,0,0,8" HorizontalAlignment="Center" />
      <Grid Name="EnemyBoardGrid">
        <!-- Grid будет создан в code-behind -->
      </Grid>
    </StackPanel>
  </StackPanel>
</UserControl>
