<?xml version="1.0" encoding="utf-8"?>
<!-- Диалог демо -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BattleOfSea.Views.DemoDialog"
        Title="Demo Mode"
        Width="420" Height="160"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16" Spacing="12">
    <TextBlock Text="Режим демо включён — вы можете просмотреть интерфейс без бекенда." TextWrapping="Wrap" />
    <TextBlock Text="Нажмите «Открыть лобби», чтобы перейти в главное окно." FontSize="12" Opacity="0.8" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Name="OpenLobbyButton" Content="Открыть лобби" Click="OpenLobby_Click" />
      <Button Name="CloseButton" Content="Закрыть" Click="Close_Click" />
    </StackPanel>
  </StackPanel>
</Window>
