<?xml version="1.0" encoding="utf-8"?>
<!-- Окно создания -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BattleOfSea.Views.CreateRoomWindow"
        Title="Создать комнату" Width="450" Height="350" WindowStartupLocation="CenterOwner"
        MinWidth="400" MinHeight="320">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16" Spacing="12">
      <TextBlock Text="Название комнаты" FontSize="14" FontWeight="Bold" />
      <TextBox Text="{Binding Name, Mode=TwoWay}" FontSize="14" />
      <TextBlock Text="{Binding NameError}" Foreground="Red" FontSize="12" />

      <TextBlock Text="Пароль (необязательно)" FontSize="14" FontWeight="Bold" Margin="0,8,0,0" />
      <TextBox Text="{Binding Password, Mode=TwoWay}" FontSize="14" />

      <TextBlock Text="Максимум игроков" FontSize="14" FontWeight="Bold" Margin="0,8,0,0" />
      <ComboBox SelectedItem="{Binding MaxPlayers, Mode=TwoWay}" ItemsSource="{Binding MaxPlayersOptions}" FontSize="14" />

      <CheckBox Content="Приватная" IsChecked="{Binding IsPrivate, Mode=TwoWay}" FontSize="14" Margin="0,8,0,0" />

      <Separator Margin="0,12" />

      <TextBlock Text="После создания комнаты вам нужно будет разместить корабли:" FontSize="12" 
                 TextWrapping="Wrap" Margin="0,4" />
      <StackPanel Margin="8,4" Spacing="4">
        <TextBlock Text="• 1 линкор (4 клетки)" FontSize="12" />
        <TextBlock Text="• 2 крейсера (3 клетки)" FontSize="12" />
        <TextBlock Text="• 3 эсминца (2 клетки)" FontSize="12" />
        <TextBlock Text="• 4 катера (1 клетка)" FontSize="12" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
        <Button Content="Отмена" Click="Cancel_Click" Width="100" FontSize="14" 
                HorizontalContentAlignment="Center" />
        <Button Content="Создать" Click="Create_Click" IsEnabled="{Binding CanCreate}" 
                Width="100" FontSize="14" HorizontalContentAlignment="Center" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
