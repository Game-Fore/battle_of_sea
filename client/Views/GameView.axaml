<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:client.ViewModels"
             x:DataType="vm:GameViewModel"
             x:Class="client.Views.GameView">
  <Grid RowDefinitions="Auto,Auto,Auto" Margin="16">
    <StackPanel>
      <TextBlock Text="Морской бой" FontSize="20" FontWeight="Bold" Margin="0,0,0,4"/>
      <TextBlock Text="{Binding Status}" Margin="0,0,0,8"/>
    </StackPanel>

    <!-- Два поля — отдельный блок фиксированного размера, не растягивается по окну -->
    <Grid Grid.Row="1" ColumnDefinitions="Auto,16,Auto"
          VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,8,0,0">
      <!-- Моё поле: свои корабли и отметки выстрелов противника -->
      <StackPanel Grid.Column="0">
        <TextBlock Text="Моё поле" FontWeight="Bold" Margin="0,0,0,4"/>
        <Border Width="190" Height="190" BorderBrush="Gray" BorderThickness="1" Padding="0">
          <ItemsControl ItemsSource="{Binding MyBoardCells}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="10" Columns="10"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GameCellViewModel">
                <Border Width="19" Height="19" Margin="0"
                        BorderBrush="Gray" BorderThickness="1"
                        Background="{Binding CellBackground}"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>

      <!-- Поле противника: выстрелы по врагу (клик — выстрел при своём ходе) -->
      <StackPanel Grid.Column="2">
        <TextBlock Text="Поле противника" FontWeight="Bold" Margin="0,0,0,4"/>
        <Border Width="190" Height="190" BorderBrush="Gray" BorderThickness="1" Padding="0">
          <ItemsControl ItemsSource="{Binding EnemyBoardCells}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="10" Columns="10"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GameCellViewModel">
                <Border Width="19" Height="19" Margin="0"
                        BorderBrush="Gray" BorderThickness="1"
                        Background="{Binding CellBackground}">
                  <Button Background="Transparent" BorderThickness="0"
                          Command="{Binding ShootCommand}"
                          CommandParameter="{Binding}"/>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>
    </Grid>

    <!-- Экран результата игры -->
    <Grid Grid.Row="2" Margin="0,16,0,0" IsVisible="{Binding GameResultVisible}">
      <Border Background="White" BorderBrush="Black" BorderThickness="2" CornerRadius="8" Padding="16">
        <StackPanel Spacing="16" VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock Text="{Binding GameResult}" FontSize="18" FontWeight="Bold" TextAlignment="Center"/>
          <Button Content="Начать новую игру" 
                  Command="{Binding PlayAgainCommand}"
                  Padding="16,8"
                  Background="Blue"
                  Foreground="White"
                  HorizontalAlignment="Center"/>
          <TextBlock Text="Ожидание решения второго игрока..." FontSize="12" TextAlignment="Center" Foreground="Gray"/>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
