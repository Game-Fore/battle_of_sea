<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="battle_sea.Views.ChatView">

	<Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10">
		<StackPanel>
			<TextBlock Text="Морской Чат" FontSize="16" FontWeight="Bold"/>

			<!-- Простое поле для истории -->
			<Border Height="200" BorderBrush="LightGray" BorderThickness="1"
					Margin="0,10" Background="White">
				<ScrollViewer>
					<ItemsControl x:Name="MessagesContainer">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding}" Margin="0,2"/>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</Border>

			<!-- Поле ввода и кнопка -->
			<StackPanel Orientation="Horizontal" Margin="0,10">
				<TextBox Width="200" x:Name="MessageTextBox"
						 Watermark="Введите сообщение..."/>
				<Button Content="Отправить" Margin="10,0,0,0"
						Click="SendButton_Click"/>
			</StackPanel>

			<!-- Кнопки подключения -->
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
				<Button Content="Подключиться" x:Name="ConnectButton"
						Click="ConnectButton_Click"/>
				<Button Content="Отключиться" x:Name="DisconnectButton"
						Click="DisconnectButton_Click" IsVisible="False"/>
			</StackPanel>
		</StackPanel>
	</Border>
</UserControl>